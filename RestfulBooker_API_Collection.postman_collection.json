            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Kiểm tra tên khách hàng khớp với dữ liệu\npm.test(\"Tên khách hàng khớp với dữ liệu\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.booking.firstname).to.eql(\"Nguyen\");\n});\n\n// Lưu lại ID phòng vừa tạo vào biến môi trường\nvar jsonData = pm.response.json();\npm.environment.set(\"bookingid\", jsonData.bookingid);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"firstname\", \"Nguyen\");\npm.environment.set(\"lastname\", \"Minh Huy\");\npm.environment.set(\"totalprice\", 1500);"
                ]
              }
            }
